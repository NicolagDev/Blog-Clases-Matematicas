---
// Sistema de comentarios: Cusdis. Permite comentar sin necesidad de crear cuenta
// (nombre opcional, sin login obligatorio) y trae panel de moderación propio.
const APP_ID = '79b720bb-6426-48a0-9269-03c607bea2a4'; // <-- reemplaza esto por el que copiaste de "Embeded code"

interface Props {
  pageId: string;
  pageTitle: string;
}
const { pageId, pageTitle } = Astro.props;
const pageUrl = Astro.url.href;
---
<section class="mt-14 pt-8 border-t border-rule">
  <h2 class="font-serif text-lg font-semibold mb-4">Preguntas y comentarios</h2>
  <div
    id="cusdis_thread"
    data-host="https://cusdis.com"
    data-app-id={APP_ID}
    data-page-id={pageId}
    data-page-url={pageUrl}
    data-page-title={pageTitle}
  ></div>
  <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
</section>